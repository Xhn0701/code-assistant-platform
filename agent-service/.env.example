# ============================================
# Agent 服务环境变量配置示例
# 复制此文件为 .env 并按需修改配置
# ============================================

# ========== 应用配置 ==========
DEBUG=True
APP_NAME=Agent Service
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ========== 服务器配置 ==========
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ========== CORS 配置 ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ========== Redis 配置 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_TIMEOUT=3

# ========== OpenAI 配置 ==========
# 必须配置！从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your-openai-api-key-here
# 可选：使用代理或自建服务
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ========== ChromaDB 配置 ==========
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=code_embeddings

# ========== 代码索引配置 ==========
INDEX_BATCH_SIZE=100
INDEX_CHUNK_SIZE=1000
INDEX_CHUNK_OVERLAP=200
INDEX_MAX_FILE_SIZE=1048576

# ========== Java 服务配置 ==========
JAVA_USER_SERVICE_URL=http://localhost:8080

# ========== 速率限制配置 ==========
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100

