# ==================== 通用配置 ====================
APP_NAME=Code Assistant Platform
ENVIRONMENT=development

# ==================== 数据库配置 ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=code_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ==================== Redis配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Java服务配置 ====================
JAVA_USER_SERVICE_PORT=8080
JAVA_PROJECT_SERVICE_PORT=8081

# JWT配置
JWT_SECRET=your-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==================== Python Agent服务配置 ====================
PYTHON_AGENT_SERVICE_PORT=8000

# LLM配置 (选择一个)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 智谱AI (可选)
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_MODEL=glm-4

# 百川 (可选)
# BAICHUAN_API_KEY=your-baichuan-api-key

# ==================== 向量数据库配置 ====================
CHROMA_PERSIST_DIR=/data/vectorstore
EMBEDDING_DIMENSION=1536

# ==================== Nginx配置 ====================
NGINX_PORT=80

# ==================== 代码索引配置 ====================
MAX_FILE_SIZE_MB=10
SUPPORTED_LANGUAGES=python,java,javascript,typescript,go,rust
CODE_CHUNK_SIZE=1000
CODE_CHUNK_OVERLAP=200

# ==================== GitHub配置 (可选) ====================
GITHUB_ACCESS_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ==================== 其他配置 ====================
LOG_LEVEL=INFO
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
